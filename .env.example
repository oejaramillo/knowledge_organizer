# ============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is git-ignored and must never be committed.
# ============================================================================

# ── Database (required by all three components) ─────────────────────────────
# Neon / Postgres connection string. Always keep sslmode=require for Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Zotero (zotero_sync) ────────────────────────────────────────────────────
# Zotero local API. Keep the default while Zotero Desktop is running.
ZOTERO_URL=http://localhost:23119/api

# ── AI enrichment (ai_enrichments) ──────────────────────────────────────────
# Only the provider you actually use needs a key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Dashboard API (board/backend) ───────────────────────────────────────────
# Browser origins allowed to call the API: a comma-separated list, or "*".
# Defaults to the Vite/React dev servers when unset.
# Recommended for a personal setup: leave it as the exact origin you use.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication is OFF by default: the API is meant to listen on 127.0.0.1 for
# a single user. Turn it on only if you bind the API to a non-loopback address,
# then set the same value as VITE_API_TOKEN below.
API_AUTH_ENABLED=false
API_TOKEN=

# ── Dashboard frontend (board/frontend) ─────────────────────────────────────
# Only needed when the API does not run on http://127.0.0.1:8000/api.
# VITE_API_URL=http://127.0.0.1:8000/api
# Required only when API_AUTH_ENABLED=true.
# VITE_API_TOKEN=

# ============================================================================
# NOT READ BY THE CURRENT CODE
# These keys showed up in older .env files but nothing consumes them. They are
# listed so the gap is explicit rather than surprising.
#   DEFAULT_CONTRIBUTOR_ID — change_log / contributor attribution is not wired up.
#   HOST / PORT            — the API is started with `uvicorn main:app`.
#   FLASK_DEBUG            — this is a FastAPI app.
# ============================================================================
